{
  "name": "firstflag",
  "version": "0.1.0",
  "private": true,
  "description": "Learn cybersecurity on a real Linux machine in your browser: seeded CTF missions, per-student HMAC flags, a solvability verifier, and an AI tutor that never sees the flag.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/copy-wasm.mjs && node scripts/dev.mjs",
    "build": "node scripts/copy-wasm.mjs && vite build --config web/vite.config.mjs",
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "verify": "node verify/verify.mjs --seeds 6",
    "eval": "node --disable-warning=ExperimentalWarning evals/run.mjs",
    "eval:guard": "node --disable-warning=ExperimentalWarning evals/run.mjs --suite guard",
    "image": "python3 vm/build_image.py",
    "smoke": "node verify/vmrunner.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/martian-mono": "5.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "v86": "0.5.473"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.2.1",
    "playwright": "1.63.0",
    "vite": "8.3.6"
  }
}
